{
  "private": true,
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "npx prettier --check  \"src/**/*.js\"",
    "prettier:fix": "npx prettier --write \"src/**/*.js\"",
    "check": "npm run lint && npm test",
    "build": "esbuild src/main.js --bundle --platform=neutral --format=cjs --target=es2019 --outfile=dist/main.js",
    "format": "npm run prettier && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
