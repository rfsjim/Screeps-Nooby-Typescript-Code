{
  "private": true,
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js test/*.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier:fix": "npx prettier --write \"{src,test,server-scripts}/**/*.{js,mjs}\"",
    "prettier": "npx prettier --check \"{src,test,server-scripts}/**/*.{js,mjs}\"",
    "check": "npm run lint && npm test",
    "build": "esbuild src/main.js --bundle --platform=neutral --format=cjs --target=es2019 --outfile=dist/main.js",
    "verify": "npm run prettier && npm run lint",
    "format": "npm run prettier:fix && npm run lint:fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@types/screeps": "^3.4.0"
  }
}
